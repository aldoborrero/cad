# Generated CAD artifacts (source of truth is the .scad / .FCStd)
**/exports/

# direnv / nix
.direnv/
result
result-*
# OrcaSlicer/Bambu Studio drop this next to wherever they were run
result.json

# FreeCAD backups / locks
*.FCStd1
*.FCBak
*.FCStd.lock

# KiCad backups / autosaves / caches (the project trio is the source of truth)
*-backups/
_autosave-*
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
fp-info-cache
# Written while a project is open in KiCad and left behind when it is not closed cleanly.
~*.lck

# The editor's local-history extension, which keeps a git repo of its own inside the
# project. Not ours, and nothing should ever read it.
.history/

# Python
__pycache__/
*.pyc

# scratch clone for analysis
.scratch/

# git worktrees created for feature work
.claude/worktrees/

# Local ESPHome credentials; keep only the supplied examples in Git.
**/esphome/secrets.yaml
