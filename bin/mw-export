#!/usr/bin/env python3
"""Flatten marble-run into the single .scad MakerWorld's Parametric Model Maker takes.

PMM runs OpenSCAD server-side and builds a customizer out of the script's top-level
assignments, but it resolves no `include`/`use` of your own files -- only of the libraries
it bundles, BOSL2 among them. marble-run is a library plus thirty piece files, so it cannot
be uploaded as it stands. This writes the one file PMM will accept.

    bin/mw-export                 # -> projects/marble-run/openscad/exports/marble-run-makerworld.scad
    bin/mw-export --check         # ...and build every part from it, against the originals
    bin/mw-export -o some.scad

What it has to do beyond concatenating:

  * KEEP `include <BOSL2/std.scad>` and drop every local one. BOSL2 is bundled; lib.scad is
    not.
  * Drop each piece file's trailing bare call. Every one ends with `mr_teal();` so that it
    renders when opened on its own, which in one file renders all thirty at once.
  * Fold away the include-and-override idiom. A piece may `include` the library and then
    reassign its parameters -- catchers/catcher_hape.scad reassigns eight CATCH_* values --
    which is contained while the files are separate. Concatenated they land in one scope,
    OpenSCAD's last assignment wins, and every catcher silently comes out with the Hape
    proportions. Nothing errors; the parts are just wrong. Each override is folded into the
    library's OWN assignment as a ternary on `part`, so it applies to its piece and no other.
  * Give `part` a dropdown. PMM turns a bare string into a free-text box, and the user would
    have to type `rail_curve120_a` exactly.
  * Leave `catalogue` out: 27 pieces and 308000 facets, for looking at rather than printing.

--check is the part that matters. A flattener whose output merely *builds* has proved
nothing: concatenated naively, `catcher` builds without a murmur and comes out at
112.770 cm3 -- the Hape bowl, 53.8 % over the wedge's 73.327 -- because the overrides leaked.
So every part is built from both the flattened file and the sources and compared on volume,
and any OpenSCAD warning at all counts as a failure.
"""

import argparse
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = pathlib.Path(
    subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
)
SRC = ROOT / "projects" / "marble-run" / "openscad"
MAIN = SRC / "marble-run.scad"
LIB = SRC / "lib.scad"
DEFAULT_OUT = SRC / "exports" / "marble-run-makerworld.scad"

# Whole plans rather than pieces. `all` stays -- it is the printable plate.
DROP_PARTS = {"catalogue"}

BOSL2 = "include <BOSL2/std.scad>"
BUNDLED = ("BOSL2/", "Round-Anything/")
_GLOBAL = re.compile(r"^([A-Z][A-Z0-9_]*)\s*=")
_LOCAL_IMPORT = re.compile(r"^\s*(?:include|use)\s*<([^>]+)>\s*;?\s*$")
# A piece file ends by rendering itself, so that opening it shows the piece. Not always as
# a bare call: rails/curve120_split.scad and towers/drop.scad place their two variants side
# by side with a translate() first. Matching only the bare form left those two rendering
# unconditionally in the flattened file -- a constant 298.63 cm3 on top of EVERY part, which
# is rail_curve120_b plus drop_tower_2 exactly. So: any top-level statement calling one.
_RENDER_CALL = re.compile(r"^(?!\s)(?!module\b|function\b).*?\b(mr_\w+)\s*\(")
_DISPATCH = re.compile(r'\bname\s*==\s*"([A-Za-z0-9_]+)"')


def is_local_import(line):
    m = _LOCAL_IMPORT.match(line)
    return bool(m) and not m.group(1).startswith(BUNDLED)


def globals_of(text):
    """Top-level uppercase assignments -- what a piece file can collide with."""
    return {m.group(1) for line in text.splitlines() if (m := _GLOBAL.match(line))}


def piece_files():
    """The piece files, in the order marble-run.scad imports them."""
    out = []
    for line in MAIN.read_text().splitlines():
        m = re.match(r"^\s*use\s*<([^>]+)>", line)
        if m and not m.group(1).startswith(BUNDLED):
            out.append(SRC / m.group(1))
    return out


def part_names():
    """Every selectable part, read off the dispatch chain -- the same source check.py reads,
    so the two cannot disagree about what exists."""
    seen = []
    for n in _DISPATCH.findall(MAIN.read_text()):
        if n not in seen and n not in DROP_PARTS:
            seen.append(n)
    return ["all"] + seen


def modules_to_parts():
    return {
        m.group(2): m.group(1)
        for m in re.finditer(
            r'name\s*==\s*"([A-Za-z0-9_]+)"\)\s*(mr_\w+)\s*\(', MAIN.read_text()
        )
    }


def strip_piece(path, lib_globals, part_of_module):
    """A piece file ready to concatenate, plus any library parameters it overrode.

    The overrides come OUT of the body and are handed back, because leaving them in is
    exactly the failure this script exists to prevent.
    """
    body, overrides = [], {}
    module_here = None
    for line in path.read_text().splitlines():
        if is_local_import(line):
            continue
        if (m := _RENDER_CALL.match(line)) and line.rstrip().endswith(";"):
            module_here = module_here or m.group(1)
            continue
        if (m := _GLOBAL.match(line)) and m.group(1) in lib_globals:
            # comment first, THEN the semicolon: on `X = 112;   // why` the `;` is not at the
            # end of the line, and stripping the other way round leaves it inside the
            # ternary, which is a syntax error rather than a wrong number.
            overrides[m.group(1)] = (
                line[m.end() :].partition("//")[0].strip().rstrip(";").strip()
            )
            continue
        body.append(line)

    # The bare call names the module and the module names the part, but that call is the last
    # line in the file, so the owner is only known once it has all been read.
    owner = part_of_module.get(module_here or "")
    if overrides and not owner:
        raise SystemExit(
            f"{path.name}: overrides {', '.join(sorted(overrides))} but no part could be "
            f"matched to it, so the override cannot be scoped and would reach every piece."
        )
    return "\n".join(body), {k: (v, owner) for k, v in overrides.items()}


def fold_overrides(lib_body, overrides):
    """Rewrite the library's own assignment as a ternary on `part`.

    In place, not beside it. A second top-level assignment of the same name is what OpenSCAD
    reports as "assigned ... but was overwritten", and it leaves the file depending on
    declaration order instead of saying what it means.
    """
    by_name = {}
    for name, (value, owner) in overrides.items():
        by_name.setdefault(name, []).append((owner, value))

    out = []
    for line in lib_body:
        if (m := _GLOBAL.match(line)) and m.group(1) in by_name:
            name = m.group(1)
            head, _, comment = line[m.end() :].partition("//")
            expr = head.strip().rstrip(";").strip()
            for owner, value in reversed(by_name[name]):
                expr = f'(part == "{owner}") ? {value} : {expr}'
            out.append(
                f"{name} = {expr};"
                + (f"  // {comment.strip()}" if comment.strip() else "")
            )
        else:
            out.append(line)
    return out


def build(out_path):
    lib_text = LIB.read_text()
    lib_globals = globals_of(lib_text)
    part_of_module = modules_to_parts()

    pieces, overrides = [], {}
    for f in piece_files():
        body, ov = strip_piece(f, lib_globals, part_of_module)
        pieces.append((f.relative_to(SRC), body))
        overrides.update(ov)

    lib_body = fold_overrides(
        [ln for ln in lib_text.splitlines() if ln.strip() != BOSL2], overrides
    )
    parts = part_names()

    chunks = [
        "// marble-run, flattened for MakerWorld's Parametric Model Maker.",
        "//",
        "// GENERATED by bin/mw-export -- do not edit. The sources are",
        "// projects/marble-run/openscad/{lib.scad, <piece>.scad, marble-run.scad}.",
        "//",
        "// PMM resolves no local includes, only the libraries it bundles, so the library and",
        "// every piece file are concatenated here. BOSL2 stays an include: PMM has it.",
        "",
        BOSL2,
        "",
        "/* [Part] */",
        "// which piece to build",
        f'part = "all"; // [{", ".join(parts)}]',
        "",
        "// ---------------- lib.scad ----------------",
        "\n".join(lib_body),
        "",
    ]
    for rel, body in pieces:
        chunks += [f"// ---------------- {rel} ----------------", body, ""]

    # Dropping a part means dropping its table, its module and its dispatch line. The module
    # has to go by brace depth, not by matching its header: taking the header alone leaves
    # the body behind as an orphan, which is a parser error rather than anything subtle.
    main_body, in_table, depth = [], False, 0
    for line in MAIN.read_text().splitlines():
        if depth:
            depth += line.count("{") - line.count("}")
            continue
        if is_local_import(line) or line.strip() == BOSL2:
            continue
        if re.match(r"^\s*part\s*=", line):
            continue
        if in_table:
            in_table = not line.startswith("];")
            continue
        if any(re.match(rf"^{p.upper()} = \[", line) for p in DROP_PARTS):
            in_table = True
            continue
        if any(re.match(rf"^\s*module {p}\(\)", line) for p in DROP_PARTS):
            # its comment block goes with it
            while main_body and main_body[-1].startswith("//"):
                main_body.pop()
            depth = line.count("{") - line.count("}")
            continue
        if any(f'"{p}"' in line for p in DROP_PARTS):
            continue
        main_body.append(line)
    chunks += [
        "// ---------------- marble-run.scad ----------------",
        "\n".join(main_body),
    ]

    text = re.sub(r"\n{3,}", "\n\n", "\n".join(chunks)).rstrip() + "\n"
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(text)
    return text, parts, overrides


def openscad():
    exe = shutil.which("openscad")
    if not exe:
        sys.exit("no openscad on PATH -- run inside `nix develop`")
    return exe


def render(scad, part, out):
    r = subprocess.run(
        [
            openscad(),
            "--backend=Manifold",
            "-D",
            f'part="{part}"',
            "-o",
            str(out),
            str(scad),
        ],
        capture_output=True,
        text=True,
    )
    return r.returncode, [
        ln for ln in r.stderr.splitlines() if "WARNING" in ln or "ERROR" in ln
    ]


def check(scad, parts):
    """Build every part from both files and compare. Any warning is a failure: the flattened
    file is generated, so there is no reason for it to be noisier than its sources."""
    try:
        import trimesh
    except ImportError:
        sys.exit("--check needs trimesh -- run inside `nix develop`")

    bad = 0
    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        for p in parts:
            a, b = tmp / f"a_{p}.stl", tmp / f"b_{p}.stl"
            rc1, w1 = render(scad, p, a)
            rc2, _ = render(MAIN, p, b)
            if rc1 or rc2 or not a.exists() or not b.exists():
                print(f"  FAIL  {p:<18} build failed")
                bad += 1
            elif w1:
                print(f"  FAIL  {p:<18} {w1[0][:78]}")
                bad += 1
            else:
                va, vb = trimesh.load(a).volume, trimesh.load(b).volume
                d = abs(va - vb) / vb * 100 if vb else 0.0
                if d > 0.001:
                    print(
                        f"  FAIL  {p:<18} {va / 1000:.4f} vs {vb / 1000:.4f} cm3 ({d:.3f}%)"
                    )
                    bad += 1
                else:
                    print(f"  ok    {p:<18} {va / 1000:8.3f} cm3")
    print(f"\n{len(parts) - bad}/{len(parts)} parts identical to the sources")
    return bad


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("-o", "--out", type=pathlib.Path, default=DEFAULT_OUT)
    ap.add_argument("--check", action="store_true", help="build every part and compare")
    args = ap.parse_args()

    text, parts, overrides = build(args.out)
    print(f"wrote {args.out}  ({len(text.splitlines())} lines, {len(parts)} parts)")
    for name, (value, owner) in sorted(overrides.items()):
        print(f"  scoped {name} = {value}  to part={owner}")
    if args.check:
        print()
        return 1 if check(args.out, parts) else 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
