#!/usr/bin/env bash
# cad — manage CAD projects in this monorepo (OpenSCAD + FreeCAD)
set -euo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null || echo "${PRJ_ROOT:-$PWD}")"

die() {
  echo "cad: $*" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
cad — manage CAD projects

  cad ls                          list all projects
  cad new openscad|freecad NAME   scaffold a new project from the template
  cad render NAME [VIEW]          OpenSCAD PNG preview (VIEW: iso|fit|top|front|side)
  cad export NAME                 build the project (tool-aware):
                                    openscad -> STL (+3MF)
                                    freecad  -> STEP + STL (runs <name>.py headless)
  cad step NAME                   OpenSCAD project -> STEP via FreeCAD (best-effort)
  cad gui NAME                    open the project (OpenSCAD GUI / FreeCAD)

NAME may be a bare name, or "openscad/NAME" / "freecad/NAME" when it exists in both.
EOF
}

# Resolve NAME -> R_TOOL, R_NAME (path under the tool), R_LEAF (entry basename).
# Accepts "tool/sub[/sub...]", or a bare "sub[/sub...]" searched across tools.
# A project dir is "<tool>/<R_NAME>" and its entry file is "<R_LEAF>.<ext>".
R_TOOL=""
R_NAME=""
R_LEAF=""
resolve() {
  local arg="$1" tool found=()
  local first="${arg%%/*}"
  if [ "$first" = openscad ] || [ "$first" = freecad ]; then
    local sub="${arg#*/}"
    { [ -n "$sub" ] && [ "$sub" != "$arg" ] && [ -d "$root/$first/$sub" ]; } || return 1
    R_TOOL="$first"
    R_NAME="$sub"
    R_LEAF="${sub##*/}"
    return 0
  fi
  for tool in openscad freecad; do
    [ -d "$root/$tool/$arg" ] && found+=("$tool")
  done
  case "${#found[@]}" in
  0) return 1 ;;
  1)
    R_TOOL="${found[0]}"
    R_NAME="$arg"
    R_LEAF="${arg##*/}"
    return 0
    ;;
  *) return 2 ;;
  esac
}

need() {
  local name="$1" rc=0
  [ -n "$name" ] || die "missing project name"
  resolve "$name" || rc=$?
  if [ "$rc" -eq 2 ]; then
    die "'$name' exists in both tools; use openscad/$name or freecad/$name"
  elif [ "$rc" -ne 0 ]; then
    die "no such project: $name"
  fi
  return 0
}

# OpenSCAD grew the Manifold CSG backend in 2023 and made it the default in 2025; on the
# snapshots in between it has to be asked for. marble-run's accelerator is a swept solid
# of a few hundred slabs and takes minutes on the old CGAL backend against seconds on
# Manifold. Builds that predate the flag reject it outright, so probe before passing it.
SCAD_BACKEND=""
SCAD_BACKEND_PROBED=""
scad_backend() {
  if [ -z "$SCAD_BACKEND_PROBED" ]; then
    SCAD_BACKEND_PROBED=1
    if openscad --help 2>&1 | grep -q -- '--backend'; then
      SCAD_BACKEND="--backend=Manifold"
    fi
  fi
  echo "$SCAD_BACKEND"
  return 0
}

view_args() {
  case "$1" in
  iso) echo "--projection=p --camera=0,0,0,58,0,215,0" ;;
  fit) echo "--projection=p --camera=0,0,0,60,0,25,0" ;;
  top) echo "--projection=o --camera=0,0,0,0,0,0,0" ;;
  front) echo "--projection=o --camera=0,0,0,90,0,0,0" ;;
  side) echo "--projection=o --camera=0,0,0,90,0,90,0" ;;
  *) die "unknown view: $1 (iso|fit|top|front|side)" ;;
  esac
}

cmd_ls() {
  local t d b ext
  for t in openscad freecad; do
    [ -d "$root/$t" ] || continue
    ext=$([ "$t" = openscad ] && echo scad || echo py)
    # a project is any dir (at any depth) holding its entry file <leaf>.<ext>
    while IFS= read -r d; do
      b="$(basename "$d")"
      case "$b" in _template | lib | exports) continue ;; esac
      [ -f "$d/$b.$ext" ] && echo "${d#"$root"/}"
    done < <(find "$root/$t" -mindepth 1 -type d ! -path '*/exports*' | sort)
  done
}

cmd_new() {
  local tool="${1:-}" name="${2:-}"
  { [ -n "$tool" ] && [ -n "$name" ]; } || die "usage: cad new openscad|freecad NAME"
  case "$tool" in openscad | freecad) ;; *) die "tool must be openscad or freecad" ;; esac
  local dest="$root/$tool/$name"
  [ -e "$dest" ] && die "$tool/$name already exists"
  cp -r "$root/$tool/_template" "$dest"
  [ "$tool" = openscad ] && [ -f "$dest/model.scad" ] && mv "$dest/model.scad" "$dest/$name.scad"
  [ "$tool" = freecad ] && [ -f "$dest/model.py" ] && mv "$dest/model.py" "$dest/$name.py"
  mkdir -p "$dest/exports"
  echo "created $tool/$name"
}

cmd_render() {
  local view="${2:-iso}" f out
  need "${1:-}"
  [ "$R_TOOL" = openscad ] || die "render is OpenSCAD-only (FreeCAD: use 'cad export')"
  f="$root/openscad/$R_NAME/$R_LEAF.scad"
  out="$root/openscad/$R_NAME/exports"
  mkdir -p "$out"
  # shellcheck disable=SC2046
  xvfb-run -a openscad $(scad_backend) -o "$out/$R_LEAF-$view.png" \
    --imgsize=1200,1000 --colorscheme=Tomorrow --viewall --autocenter \
    $(view_args "$view") "$f"
  echo "wrote $out/$R_LEAF-$view.png"
}

export_openscad() {
  local f="$root/openscad/$R_NAME/$R_LEAF.scad" out="$root/openscad/$R_NAME/exports"
  mkdir -p "$out"
  # shellcheck disable=SC2046
  xvfb-run -a openscad $(scad_backend) -o "$out/$R_LEAF.stl" "$f"
  echo "wrote $out/$R_LEAF.stl"
  # shellcheck disable=SC2046
  if xvfb-run -a openscad $(scad_backend) -o "$out/$R_LEAF.3mf" "$f" 2>/dev/null; then
    echo "wrote $out/$R_LEAF.3mf"
  else
    echo "cad: 3MF export not supported by this OpenSCAD build (skipped)" >&2
  fi
}

export_freecad() {
  local f="$root/freecad/$R_NAME/$R_LEAF.py"
  [ -f "$f" ] || die "no FreeCAD script: freecad/$R_NAME/$R_LEAF.py"
  mkdir -p "$root/freecad/$R_NAME/exports"
  freecadcmd "$f"
}

cmd_export() {
  need "${1:-}"
  case "$R_TOOL" in
  openscad) export_openscad ;;
  freecad) export_freecad ;;
  esac
}

cmd_step() {
  local out csg py
  need "${1:-}"
  [ "$R_TOOL" = openscad ] || die "step is for OpenSCAD projects; FreeCAD emits STEP via 'cad export'"
  out="$root/openscad/$R_NAME/exports"
  mkdir -p "$out"
  csg="$out/$R_LEAF.csg"
  xvfb-run -a openscad -o "$csg" "$root/openscad/$R_NAME/$R_LEAF.scad"
  py="$(mktemp --suffix=.py)"
  cat >"$py" <<PY
import os, importCSG, FreeCAD, Import
importCSG.open(os.environ["CAD_CSG"])
doc = FreeCAD.ActiveDocument
Import.export(list(doc.Objects), os.environ["CAD_STEP"])
PY
  CAD_CSG="$csg" CAD_STEP="$out/$R_LEAF.step" freecadcmd "$py" ||
    die "FreeCAD STEP conversion failed (hull()/minkowski() may not convert cleanly)"
  rm -f "$py"
  echo "wrote $out/$R_LEAF.step"
}

cmd_gui() {
  local step
  need "${1:-}"
  case "$R_TOOL" in
  openscad) openscad "$root/openscad/$R_NAME/$R_LEAF.scad" & ;;
  freecad)
    export_freecad
    step="$root/freecad/$R_NAME/exports/$R_LEAF.step"
    [ -f "$step" ] || die "build produced no $step"
    freecad "$step" &
    ;;
  esac
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
  ls) cmd_ls ;;
  new) cmd_new "$@" ;;
  render) cmd_render "$@" ;;
  export) cmd_export "$@" ;;
  step) cmd_step "$@" ;;
  gui) cmd_gui "$@" ;;
  "" | -h | --help | help) usage ;;
  *)
    usage
    exit 1
    ;;
  esac
}

main "$@"
