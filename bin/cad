#!/usr/bin/env bash
# cad — manage CAD projects in this monorepo (OpenSCAD + FreeCAD + KiCad)
#
# The layout is project-first: projects/<project>/<tool>/, so a part that exists in more
# than one kernel is one directory with both versions inside rather than two directories
# in different corners of the repo. Templates live in templates/<tool>/.
set -euo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null || echo "${PRJ_ROOT:-$PWD}")"

# The tools, and the entry file that marks a directory as buildable: <leaf>.<ext>.
# For KiCad that is the project file, which is what the GUI opens; the schematic and the
# board sit next to it under the same basename.
TOOLS=(openscad freecad kicad)

die() {
  echo "cad: $*" >&2
  exit 1
}

tool_ext() {
  case "$1" in
  openscad) echo scad ;;
  freecad) echo py ;;
  kicad) echo kicad_pro ;;
  # Deliberately not a die(): this runs inside $(...) in unit_ok, where die would only
  # leave the subshell. Every caller validates with is_tool first, so this is belt and
  # braces rather than a path anything reaches.
  *) return 1 ;;
  esac
}

is_tool() {
  local t
  for t in "${TOOLS[@]}"; do
    [ "$1" = "$t" ] && return 0
  done
  return 1
}

usage() {
  cat >&2 <<'EOF'
cad — manage CAD projects

  cad ls                          list all projects
  cad new TOOL NAME               scaffold a new project from templates/TOOL
                                    TOOL: openscad | freecad | kicad
  cad render NAME [VIEW]          PNG preview -> exports/ (not FreeCAD):
                                    openscad -> VIEW: iso|fit|top|front|side
                                    kicad    -> VIEW: iso|top|bottom|front|back|left|right
  cad export NAME                 build the project (tool-aware):
                                    openscad -> STL (+3MF)
                                    freecad  -> STEP + STL (runs <name>.py headless)
                                    kicad    -> STEP (board + component models)
  cad step NAME                   OpenSCAD project -> STEP via FreeCAD (best-effort)
  cad gui NAME                    open the project (OpenSCAD / FreeCAD / KiCad)

NAME is a path under projects/ with the tool segment optional, so `iotorero-mount` finds
the part in whichever kernel has it and `iotorero-mount/openscad` says which one.
EOF
}

# The entry file that marks a directory is "<leaf>.<ext>", where <leaf> is the project's
# own name at the tool root -- projects/marble-run/openscad/marble-run.scad -- and the
# directory's own name below it -- .../freecad/ramps/accelerator/accelerator.py.
unit_leaf() {
  local rel="$1" project rest
  project="${rel%%/*}"
  rest="${rel#*/}"
  [ "$rest" != "$rel" ] || return 1 # no tool segment, so not a unit
  if [ "${rest#*/}" = "$rest" ]; then
    echo "$project" # rel is exactly <project>/<tool>
  else
    echo "${rest##*/}"
  fi
}

# Does this path under projects/ hold its entry file? Used only in conditions, so it ends
# on a test rather than `return 0` on purpose — the caller wants the answer.
unit_ok() {
  local rel="$1" tool="$2" leaf ext
  leaf="$(unit_leaf "$rel")" || return 1
  ext="$(tool_ext "$tool")" || return 1
  [ -f "$root/projects/$rel/$leaf.$ext" ]
}

# Resolve NAME -> R_TOOL, R_REL (path under projects/, tool segment included),
# R_LEAF (entry basename) and R_DIR (the absolute directory).
R_TOOL=""
R_REL=""
R_LEAF=""
R_DIR=""
R_AMBIG=()

set_unit() {
  R_TOOL="$1"
  R_REL="$2"
  R_LEAF="$(unit_leaf "$R_REL")"
  R_DIR="$root/projects/$R_REL"
}

resolve() {
  local arg="$1" tool project sub second cand found=()
  project="${arg%%/*}"
  sub="${arg#*/}"
  [ "$sub" != "$arg" ] || sub=""

  # Already qualified: the second segment names a tool, so the argument is the path.
  second="${sub%%/*}"
  if [ -n "$second" ] && is_tool "$second"; then
    unit_ok "$arg" "$second" || return 1
    set_unit "$second" "$arg"
    return 0
  fi

  # Otherwise insert each tool after the project segment and see which ones exist.
  for tool in "${TOOLS[@]}"; do
    cand="$project/$tool${sub:+/$sub}"
    unit_ok "$cand" "$tool" && found+=("$tool")
  done
  case "${#found[@]}" in
  0) return 1 ;;
  1)
    set_unit "${found[0]}" "$project/${found[0]}${sub:+/$sub}"
    return 0
    ;;
  *)
    R_AMBIG=("${found[@]}")
    return 2
    ;;
  esac
}

need() {
  local name="$1" rc=0 t project sub qualified=()
  [ -n "$name" ] || die "missing project name"
  resolve "$name" || rc=$?
  if [ "$rc" -eq 2 ]; then
    project="${name%%/*}"
    sub="${name#*/}"
    [ "$sub" != "$name" ] || sub=""
    for t in "${R_AMBIG[@]}"; do qualified+=("$project/$t${sub:+/$sub}"); done
    die "'$name' exists under more than one tool; use ${qualified[*]}"
  elif [ "$rc" -ne 0 ]; then
    die "no such project: $name"
  fi
  return 0
}

# OpenSCAD grew the Manifold CSG backend in 2023 and made it the default in 2025; on the
# snapshots in between it has to be asked for. marble-run's accelerator is a swept solid
# of a few hundred slabs and takes minutes on the old CGAL backend against seconds on
# Manifold. Builds that predate the flag reject it outright, so probe before passing it.
SCAD_BACKEND=""
SCAD_BACKEND_PROBED=""
scad_backend() {
  if [ -z "$SCAD_BACKEND_PROBED" ]; then
    SCAD_BACKEND_PROBED=1
    if openscad --help 2>&1 | grep -q -- '--backend'; then
      SCAD_BACKEND="--backend=Manifold"
    fi
  fi
  echo "$SCAD_BACKEND"
  return 0
}

view_args() {
  case "$1" in
  iso) echo "--projection=p --camera=0,0,0,58,0,215,0" ;;
  fit) echo "--projection=p --camera=0,0,0,60,0,25,0" ;;
  top) echo "--projection=o --camera=0,0,0,0,0,0,0" ;;
  front) echo "--projection=o --camera=0,0,0,90,0,0,0" ;;
  side) echo "--projection=o --camera=0,0,0,90,0,90,0" ;;
  *) die "unknown view: $1 (iso|fit|top|front|side)" ;;
  esac
}

# kicad-cli renders from a named side rather than from a camera vector, so the view names
# are its own plus "iso" — for which -45,0,45 is the rotation `--rotate --help` itself
# gives as the isometric example.
kicad_view_args() {
  case "$1" in
  iso) echo "--side top --perspective --rotate -45,0,45" ;;
  top | bottom | front | back | left | right) echo "--side $1" ;;
  *) die "unknown view: $1 (iso|top|bottom|front|back|left|right)" ;;
  esac
}

cmd_ls() {
  local d rel tool
  [ -d "$root/projects" ] || return 0
  # A unit is at least <project>/<tool>, hence mindepth 2. templates/ and lib/ are not
  # under projects/, so unlike the old layout there is no reserved-name list to keep.
  while IFS= read -r d; do
    rel="${d#"$root"/projects/}"
    tool="${rel#*/}"
    tool="${tool%%/*}"
    is_tool "$tool" || continue
    unit_ok "$rel" "$tool" && echo "$rel"
  done < <(find "$root/projects" -mindepth 2 -type d ! -path '*/exports*' | sort)
  # The loop's last statement is `unit_ok && echo`, so without this `cad ls` exits 1
  # whenever the last directory walked is not a unit — which it usually is not.
  return 0
}

cmd_new() {
  local tool="${1:-}" name="${2:-}" project sub dest leaf f
  { [ -n "$tool" ] && [ -n "$name" ]; } || die "usage: cad new ${TOOLS[*]} NAME"
  is_tool "$tool" || die "tool must be one of: ${TOOLS[*]}"
  project="${name%%/*}"
  sub="${name#*/}"
  [ "$sub" != "$name" ] || sub=""
  dest="$root/projects/$project/$tool${sub:+/$sub}"
  [ -e "$dest" ] && die "projects/$project/$tool${sub:+/$sub} already exists"
  mkdir -p "$(dirname "$dest")"
  cp -r "$root/templates/$tool" "$dest"
  # Rename every model.* the template carries, not just the entry file: a KiCad project
  # is three files (.kicad_pro/.kicad_sch/.kicad_pcb) and they have to share a basename
  # for the project to find its schematic and board.
  leaf="${name##*/}"
  for f in "$dest"/model.*; do
    [ -e "$f" ] || continue
    mv "$f" "$dest/$leaf.${f##*/model.}"
  done
  mkdir -p "$dest/exports"
  echo "created projects/$project/$tool${sub:+/$sub}"
}

render_openscad() {
  local view="$1" out camera
  # Assigned on its own line, not as part of `local`: `local x="$(f)"` takes the exit
  # status of `local`, so a die() inside the substitution — which only leaves the
  # subshell — would be swallowed and an unknown view would render with the default
  # camera after printing the error.
  camera="$(view_args "$view")"
  out="$R_DIR/exports"
  mkdir -p "$out"
  # shellcheck disable=SC2046,SC2086
  xvfb-run -a openscad $(scad_backend) -o "$out/$R_LEAF-$view.png" \
    --imgsize=1200,1000 --colorscheme=Tomorrow --viewall --autocenter \
    $camera "$R_DIR/$R_LEAF.scad"
  echo "wrote $out/$R_LEAF-$view.png"
}

# kicad-cli's raytracer is pure software, so unlike openscad's preview this needs no
# xvfb-run and no GL.
render_kicad() {
  local view="$1" pcb out camera
  camera="$(kicad_view_args "$view")" # see render_openscad on why this is its own line
  pcb="$R_DIR/$R_LEAF.kicad_pcb"
  [ -f "$pcb" ] || die "no board: projects/$R_REL/$R_LEAF.kicad_pcb"
  out="$R_DIR/exports"
  mkdir -p "$out"
  # shellcheck disable=SC2086
  kicad-cli pcb render -o "$out/$R_LEAF-$view.png" \
    --width 1200 --height 1000 --quality high --background opaque \
    $camera "$pcb"
  echo "wrote $out/$R_LEAF-$view.png"
}

cmd_render() {
  need "${1:-}"
  case "$R_TOOL" in
  openscad) render_openscad "${2:-iso}" ;;
  kicad) render_kicad "${2:-iso}" ;;
  freecad) die "render is not available for FreeCAD projects (use 'cad export')" ;;
  esac
}

export_openscad() {
  local f="$R_DIR/$R_LEAF.scad" out="$R_DIR/exports"
  mkdir -p "$out"
  # shellcheck disable=SC2046
  xvfb-run -a openscad $(scad_backend) -o "$out/$R_LEAF.stl" "$f"
  echo "wrote $out/$R_LEAF.stl"
  # shellcheck disable=SC2046
  if xvfb-run -a openscad $(scad_backend) -o "$out/$R_LEAF.3mf" "$f" 2>/dev/null; then
    echo "wrote $out/$R_LEAF.3mf"
  else
    echo "cad: 3MF export not supported by this OpenSCAD build (skipped)" >&2
  fi
}

export_freecad() {
  local f="$R_DIR/$R_LEAF.py"
  [ -f "$f" ] || die "no FreeCAD script: projects/$R_REL/$R_LEAF.py"
  mkdir -p "$R_DIR/exports"
  freecadcmd "$f"
}

export_kicad() {
  local pcb="$R_DIR/$R_LEAF.kicad_pcb" out="$R_DIR/exports"
  [ -f "$pcb" ] || die "no board: projects/$R_REL/$R_LEAF.kicad_pcb"
  mkdir -p "$out"
  # --subst-models takes a footprint's STEP/IGS model over its VRML one where it ships
  # both, which is what makes this a B-rep solid FreeCAD can work on rather than a mesh.
  # --no-dnp leaves "do not populate" parts out of the mechanical model.
  kicad-cli pcb export step --force --subst-models --no-dnp \
    -o "$out/$R_LEAF.step" "$pcb"
  echo "wrote $out/$R_LEAF.step"
}

cmd_export() {
  need "${1:-}"
  case "$R_TOOL" in
  openscad) export_openscad ;;
  freecad) export_freecad ;;
  kicad) export_kicad ;;
  esac
}

cmd_step() {
  local out csg py
  need "${1:-}"
  [ "$R_TOOL" = openscad ] || die "step is for OpenSCAD projects; FreeCAD and KiCad emit STEP via 'cad export'"
  out="$R_DIR/exports"
  mkdir -p "$out"
  csg="$out/$R_LEAF.csg"
  xvfb-run -a openscad -o "$csg" "$R_DIR/$R_LEAF.scad"
  py="$(mktemp --suffix=.py)"
  cat >"$py" <<PY
import os, importCSG, FreeCAD, Import
importCSG.open(os.environ["CAD_CSG"])
doc = FreeCAD.ActiveDocument
Import.export(list(doc.Objects), os.environ["CAD_STEP"])
PY
  CAD_CSG="$csg" CAD_STEP="$out/$R_LEAF.step" freecadcmd "$py" ||
    die "FreeCAD STEP conversion failed (hull()/minkowski() may not convert cleanly)"
  rm -f "$py"
  echo "wrote $out/$R_LEAF.step"
}

cmd_gui() {
  local step
  need "${1:-}"
  case "$R_TOOL" in
  openscad) openscad "$R_DIR/$R_LEAF.scad" & ;;
  freecad)
    export_freecad
    step="$R_DIR/exports/$R_LEAF.step"
    [ -f "$step" ] || die "build produced no $step"
    freecad "$step" &
    ;;
  # The project file, not the board: that is what opens KiCad's project manager, with the
  # schematic and the board editors one click away.
  kicad) kicad "$R_DIR/$R_LEAF.kicad_pro" & ;;
  esac
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
  ls) cmd_ls ;;
  new) cmd_new "$@" ;;
  render) cmd_render "$@" ;;
  export) cmd_export "$@" ;;
  step) cmd_step "$@" ;;
  gui) cmd_gui "$@" ;;
  "" | -h | --help | help) usage ;;
  *)
    usage
    exit 1
    ;;
  esac
}

main "$@"
