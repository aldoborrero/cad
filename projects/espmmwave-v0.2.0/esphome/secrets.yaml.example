# Copy to secrets.yaml (which ESPHome reads and you should not commit) and fill in.
#
# Upstream's example.yaml carries an empty API key, an empty OTA password and a literal
# AP password in a public repository. None of those are values to inherit, so this
# configuration reads all four from here instead.

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# `esphome generate-key` prints a valid one.
api_encryption_key: ""

ota_password: ""

# Fallback hotspot, used only when the wifi above does not come up.
ap_password: ""
