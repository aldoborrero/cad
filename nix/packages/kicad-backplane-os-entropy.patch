+// Seed from the Linux OS entropy source instead of libstdc++'s default,
+// which may select faulty 32-bit RDSEED on affected Zen 5 hosts (AMD-SB-7055).
+struct OS_RANDOM_SEED
+{
+    template<typename Iterator>
+    void generate( Iterator first, Iterator last )
+    {
+        std::random_device source( "/dev/urandom" );
+
+        for( ; first != last; ++first )
+            *first = source();
+    }
+};
+
+static boost::mt19937 makeRandomEngine()
+{
+    OS_RANDOM_SEED seed;
+    boost::mt19937 engine;
+    engine.seed( seed );
+    return engine;
+}
+
+// Seed once per thread; retain SeedGenerator's deterministic QA behavior.
+static thread_local boost::mt19937 rng = makeRandomEngine();
+static thread_local boost::uuids::basic_random_generator<boost::mt19937> randomGenerator( rng );
 
