  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QGroupBox" name="groupSlicer">
     <property name="title">
      <string>Slicer</string>
     </property>
     <layout class="QFormLayout" name="formSlicer">
      <item row="0" column="0">
       <widget class="QLabel" name="labelExecutable">
        <property name="text">
         <string>Bambu Studio executable</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="labelTolerance">
        <property name="text">
         <string>Mesh deviation for 3MF (mm)</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="Gui::PrefDoubleSpinBox" name="spinTolerance">
        <property name="toolTip">
         <string>0 leaves FreeCAD's own export setting alone. Its default already gives a 6 mm cylinder 63 sides; the error grows with radius, so lower this for large curved surfaces.</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="maximum">
         <double>1.000</double>
        </property>
        <property name="singleStep">
         <double>0.010</double>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>Tolerance</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>Mod/bambucad</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="Gui::PrefLineEdit" name="editExecutable">
        <property name="toolTip">
         <string>Leave empty to look bambu-studio up on PATH</string>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>Executable</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>Mod/bambucad</cstring>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
