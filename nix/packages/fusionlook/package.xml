<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>Fusion Look</name>
  <description>
    A Fusion-like face for stock FreeCAD 1.1: the "Fusion Dark Blue" theme (style
    parameters for the stock FreeCAD.qss, no stylesheet fork) and FusionLook, a
    startup addon that puts the document tabs at the top and styles the two tab
    strips the theme cannot reach.
  </description>
  <version>0.1.0</version>
  <date>2026-08-11</date>
  <maintainer email="aldo@aldoborrero.com">Aldo Borrero</maintainer>
  <license>LGPL-2.1-or-later</license>
  <url type="repository" branch="main">https://github.com/aldoborrero/cad</url>
  <content>
    <!-- Nothing here declares a Gui::Workbench: FusionLook adds no commands and no
         workbench tab of its own. The declaration exists so that the Addon Manager
         lists the addon, and so that FreeCADInit puts this directory on sys.path
         (Gui/FreeCADGuiInit.py, processMetadataFile) — which is what lets the
         `freecad.fusionlook` namespace package be found. The GUI entry point is
         freecad/fusionlook/init_gui.py, imported by the pkgutil walk at the end of
         FreeCADGuiInit.py; there is deliberately no InitGui.py, because with both
         present the addon would install itself twice. -->
    <workbench>
      <name>FusionLook</name>
      <description>Fusion-style document and workbench tabs</description>
      <version>0.1.0</version>
      <subdirectory>./</subdirectory>
      <tag>theme</tag>
      <tag>ui</tag>
    </workbench>
    <preferencepack>
      <name>Fusion Dark Blue</name>
      <type>Theme</type>
      <description>
        Dark blue theme in the shape of Autodesk Fusion's current UI. Palette values
        are placeholders pending eyedropping from official screenshots.
      </description>
      <version>0.1.0</version>
      <tag>dark</tag>
      <tag>theme</tag>
    </preferencepack>
  </content>
</package>
