+                IpcGraphicDefinition::Text { text: "x".to_string(), position: (0.0,0.0), rotation: 0.0, layer: "F.Fab".to_string(), size: 1.0, stroke_width_mm: 0.15 },
+            ];
+            let any = KiCadIpcClient::build_footprint_item("Lib:Part", "R1", "R", &pads, &graphics,
+                &IpcFieldPlacement::default(), 10.0, 20.0, 90.0, "F.Cu").unwrap();
+            let fp = kiapi::board::types::FootprintInstance::decode(any.value.as_slice()).unwrap();
+            let mut insert = |id: Option<kiapi::common::types::Kiid>| {
+                let value = id.expect("missing item ID").value;
+                assert!(!value.is_empty());
+                assert!(ids.insert(value), "a new imported item reused an identity");
+            };
+            insert(fp.id);
+            for field in [fp.reference_field,fp.value_field,fp.datasheet_field,fp.description_field] {
+                insert(field.unwrap().text.unwrap().id);
+            }
+            for child in fp.definition.unwrap().items {
+                if crate::builders::any_is(&child,"kiapi.board.types.Pad") {
+                    insert(kiapi::board::types::Pad::decode(child.value.as_slice()).unwrap().id);
+                } else if crate::builders::any_is(&child,"kiapi.board.types.BoardText") {
+                    insert(kiapi::board::types::BoardText::decode(child.value.as_slice()).unwrap().id);
+                } else {
+                    insert(kiapi::board::types::BoardGraphicShape::decode(child.value.as_slice()).unwrap().id);
