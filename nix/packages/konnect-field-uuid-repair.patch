+// Repair only duplicated identifiers of non-electrical footprint metadata fields.
+// Preserve copper/graphic IDs and refuse ambiguous electrical or grouped cases.
+fn prepare_duplicate_field_uuid_repair(content: &str) -> anyhow::Result<(String, serde_json::Value)> {
+    check_single_board_form(content).map_err(anyhow::Error::msg)?;
+    let mut counts: HashMap<String, usize> = HashMap::new();
+    for start in find_block_starts(content, "uuid") {
+        let (_, end) = find_balanced_block(content, start).context("unbalanced UUID")?;
+        let node = konnect_sexp::parse_sexp(&content[start..end])?;
+        let id = node.get(1).and_then(konnect_sexp::SexpNode::as_str).context("invalid UUID")?;
+        *counts.entry(id.to_string()).or_default() += 1;
+    }
+    let mut remaining = counts.clone();
+    let mut edits = Vec::new();
+    let mut repairs = Vec::new();
+    for (fp_start, fp_end, tag) in direct_children_with_tags(content, "kicad_pcb")? {
+        if tag != "footprint" { continue; }
+        let fp_text = &content[fp_start..fp_end];
+        let fp_node = konnect_sexp::parse_sexp(fp_text)?;
+        let reference = footprint_reference(&fp_node).context("footprint reference missing")?;
+        for (prop_start, prop_end, prop_tag) in direct_children_with_tags(fp_text, "footprint")? {
+            if prop_tag != "property" { continue; }
+            let property = &fp_text[prop_start..prop_end];
+            let prop_node = konnect_sexp::parse_sexp(property)?;
+            let field = prop_node.get(1).and_then(konnect_sexp::SexpNode::as_str).unwrap_or("");
+            if !matches!(field, "Description" | "Datasheet") { continue; }
+            for (uuid_start, uuid_end, uuid_tag) in direct_children_with_tags(property, "property")? {
+                if uuid_tag != "uuid" { continue; }
+                let node = konnect_sexp::parse_sexp(&property[uuid_start..uuid_end])?;
+                let id = node.get(1).and_then(konnect_sexp::SexpNode::as_str).context("invalid field UUID")?;
+                if counts.get(id).copied().unwrap_or(0) < 2 { continue; }
+                // Group/member references cannot distinguish the colliding objects.
+                for group_start in find_block_starts(content, "group") {
+                    let (_, group_end) = find_balanced_block(content, group_start).context("unbalanced group")?;
+                    if content[group_start..group_end].contains(id) {
+                        anyhow::bail!("duplicated field UUID {id} is referenced by a group");
+                    }
+                }
+                let mut replacement = new_uuid();
+                while counts.contains_key(&replacement) { replacement = new_uuid(); }
+                counts.insert(replacement.clone(), 1);
+                *remaining.get_mut(id).context("missing UUID count")? -= 1;
+                edits.push(SexpEdit::replace(fp_start + prop_start + uuid_start,
+                    fp_start + prop_start + uuid_end, format!("(uuid \"{replacement}\")")));
+                repairs.push(json!({"reference": reference, "field": field, "old_uuid": id, "new_uuid": replacement}));
+            }
+        }
+    }
+    if let Some((id, _)) = remaining.iter().find(|(_, count)| **count > 1) {
+        anyhow::bail!("duplicate UUID {id} cannot be resolved by metadata-field repair alone");
+    }
+    let updated = apply_edits(content.to_string(), edits);
+    check_single_board_form(&updated).map_err(anyhow::Error::msg)?;
+    Ok((updated, json!(repairs)))
+}
+
+async fn handle_repair_duplicate_field_uuids(args: &serde_json::Value, ctx: &ToolContext) -> anyhow::Result<CallToolResult> {
+    let board = get_path(args, "board")?;
+    if let Some(refusal) = crate::tools::pcb_board::refuse_if_board_open_in_kicad(
+        ctx.config.ipc_address.clone(), &board, "duplicate metadata UUID repair").await? {
+        return Ok(refusal);
+    }
+    let content = read_consistent(&board)?;
+    let revision = format!("{:x}", Sha256::digest(content.as_bytes()));
+    let (updated, repairs) = prepare_duplicate_field_uuid_repair(&content)?;
+    let dry_run = args["dry_run"].as_bool().unwrap_or(true);
+    if !dry_run {
+        if args["expected_revision"].as_str() != Some(revision.as_str()) {
+            return Ok(CallToolResult::error("Expected revision does not match the current closed board"));
+        }
+        if content != updated { persist_board_replacement(&board, &content, &updated)?; }
+    }
+    Ok(CallToolResult::json(&json!({"source": "file", "dry_run": dry_run, "revision": revision, "repairs": repairs})))
+}
+
+#[cfg(test)]
+mod duplicate_metadata_uuid_tests {
+    use super::*;
+    #[test]
+    fn changes_only_colliding_metadata_identifiers() {
+        let original = r#"(kicad_pcb (footprint "X" (property "Reference" "R1") (property "Datasheet" "url" (uuid "shared")) (pad "1" smd rect (uuid "shared")) (property "Description" "unchanged" (uuid "unique"))))"#;
+        let (fixed, repairs) = prepare_duplicate_field_uuid_repair(original).unwrap();
+        assert_eq!(repairs.as_array().unwrap().len(), 1);
+        assert!(fixed.contains("(pad \"1\" smd rect (uuid \"shared\"))"));
+        assert!(fixed.contains("(property \"Description\" \"unchanged\" (uuid \"unique\"))"));
+        let replacement = repairs[0]["new_uuid"].as_str().unwrap();
+        assert_eq!(fixed.replace(replacement, "shared"), original);
+    }
+    #[test]
+    fn refuses_electrical_duplicates_and_group_ambiguity() {
+        let electrical = r#"(kicad_pcb (footprint "X" (property "Reference" "R1") (pad "1" smd rect (uuid "same")) (pad "2" smd rect (uuid "same"))))"#;
+        assert!(prepare_duplicate_field_uuid_repair(electrical).is_err());
+        let grouped = r#"(kicad_pcb (footprint "X" (property "Reference" "R1") (property "Datasheet" "" (uuid "same")) (pad "1" smd rect (uuid "same"))) (group "g" (members "same")))"#;
+        assert!(prepare_duplicate_field_uuid_repair(grouped).is_err());
+    }
+    #[test]
+    fn valid_board_is_byte_identical_and_repair_is_idempotent() {
+        let valid = r#"(kicad_pcb (footprint "X" (property "Reference" "R1") (property "Datasheet" "" (uuid "one")) (pad "1" smd rect (uuid "two"))))"#;
+        let (fixed, repairs) = prepare_duplicate_field_uuid_repair(valid).unwrap();
+        assert_eq!(fixed, valid);
+        assert!(repairs.as_array().unwrap().is_empty());
+    }
+}
